# MongoDB connection URI (optional - CineSuggest runs with an integrated in-memory fallback store if MongoDB is not provided)
MONGODB_URI=

# Secret key used for signing and verifying JWT tokens
JWT_SECRET=cinesuggest_super_secret_jwt_key_2026

# TMDB (The Movie Database) API Key or API Read Access Token
# Supported formats:
# 1. v3 32-character API key (e.g. "a1b2c3d4...")
# 2. v4 Read Access Token (JWT format starting with "eyJhbGciOi...")
# Aliases also supported on Vercel: VITE_TMDB_API_KEY, TMDB_READ_ACCESS_TOKEN, TMDB_ACCESS_TOKEN
TMDB_API_KEY=

# Google Gemini API key for natural language movie query understanding and AI insights
# Aliases also supported: GOOGLE_API_KEY, VITE_GEMINI_API_KEY
GEMINI_API_KEY=

# Server port (defaults to 3000 in AI Studio / container, or dynamic PORT on cloud hosts)
PORT=3000

# Optional: Frontend API URL if frontend is hosted on a different domain or port from backend
# VITE_API_URL=
